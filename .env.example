NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_key
# Older Supabase projects can temporarily use the legacy server-role key instead.
# SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_TIMEZONE=Asia/Kolkata
MENTOR_NAME=Your Mentor Name
MENTOR_EMAIL=mentor@example.com
MENTOR_PASSWORD=change-this-to-a-long-unique-password
STUDENT_NAME=Your Student Name
STUDENT_EMAIL=student@example.com
STUDENT_PASSWORD=change-this-to-a-different-long-password
# Optional provider integration can be added without exposing keys to the browser.
# AI_PROVIDER_API_KEY=
